@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 15px; background: #f8fafc;">
                <small class="text-muted uppercase fw-bold" style="font-size: 0.7rem;">Toplam Kategori</small>
                <h4 class="fw-bold mb-0" style="color: #4338ca;">@ViewBag.ToplamKategori</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 15px; background: #f8fafc;">
                <small class="text-muted uppercase fw-bold" style="font-size: 0.7rem;">Toplam Ürün</small>
                <h4 class="fw-bold mb-0" style="color: #0ea5e9;">@ViewBag.ToplamUrun</h4>
            </div>
        </div>
    </div>
}
