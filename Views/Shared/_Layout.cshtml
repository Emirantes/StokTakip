@{
    var currentController =
    ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
    ViewContext.RouteData.Values["action"]?.ToString();

    const string siteUrl = "https://stoknova.com.tr";
    string canonicalUrl = $"{siteUrl}{Context.Request.Path}";
}

<!DOCTYPE html>
<html lang="tr">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "StokNova") - StokNova</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/sweetalert2/sweetalert2.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        body {
            margin: 0;
            background: #f4f6f9;
            font-family: Arial, Helvetica, sans-serif;
            overflow-x: hidden;
        }

        #wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        #sidebar-wrapper {
            width: 270px;
            background: #111827;
            color: white;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1000;
            transition: all 0.3s;
        }

        .sidebar-heading {
            font-size: 24px;
            font-weight: bold;
            padding: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .profile-box {
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .profile-role {
            color: #9ca3af;
            font-size: 14px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #d1d5db;
            text-decoration: none;
            padding: 15px 25px;
            transition: 0.2s;
        }

            .sidebar-link:hover {
                background: rgba(255,255,255,0.08);
                color: white;
            }

            .sidebar-link.active {
                background: #2563eb;
                color: white;
            }

        .logout-btn {
            border-radius: 10px;
            height: 45px;
        }

        /* CONTENT */

        #page-content-wrapper {
            margin-left: 270px;
            width: calc(100% - 270px);
        }

        .navbar-custom {
            background: white;
            border-radius: 18px;
        }

        .mobile-toggle {
            display: none;
        }

        .card {
            border: none;
            border-radius: 18px;
        }

        .table-responsive {
            overflow-x: auto;
            border-radius: 18px;
        }

        /* MOBILE */

        @@media(max-width:992px) {

            #sidebar-wrapper {
                left: -270px;
            }

                #sidebar-wrapper.active {
                    left: 0;
                }

            #page-content-wrapper {
                margin-left: 0;
                width: 100%;
            }

            .mobile-toggle {
                display: inline-block;
            }

            .sidebar-heading {
                font-size: 22px;
            }
        }

    </style>
    <meta name="description"
          content="StokNova bulut tabanlı stok takip ve depo yönetim sistemidir." />

    <meta name="keywords"
          content="stok takip, stok yönetimi, depo takip, ürün yönetimi, stok programı" />

    <meta name="author"
          content="StokNova" />

    <meta name="robots"
          content="index,follow" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <meta property="og:type"
          content="website" />

    <meta property="og:title"
          content="@(ViewData["Title"] ?? "StokNova")" />

    <meta property="og:description"
          content="Bulut tabanlı stok takip sistemi." />

    <meta property="og:url"
          content="@canonicalUrl" />

    <meta property="og:site_name"
          content="StokNova" />

    <meta name="twitter:card"
          content="summary_large_image" />

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Organization",
            "name": "StokNova",
            "url": "https://stoknova.com.tr",
            "email": "admin@stoknova.com"
        }
    </script>

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "SoftwareApplication",
            "name": "StokNova",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web",
            "url": "https://stoknova.com.tr",
            "description": "Bulut tabanlı stok takip ve depo yönetim sistemi."
        }
    </script>

    <link rel="icon"
          type="image/png"
          href="~/favicon.png" />

</head>

<body>

    <div id="wrapper">

        <!-- SIDEBAR -->

        <div id="sidebar-wrapper">

            <div class="sidebar-heading">
                StokNova
            </div>

            <div class="profile-box">

                <div class="d-flex align-items-center">

                    <i class="bi bi-person-circle"
                       style="font-size:45px;"></i>

                    <div class="ms-3">

                        <div class="fw-bold">
                            @Context.Session.GetString("Username")
                        </div>

                        <div class="profile-role">
                            @Context.Session.GetString("Role")
                        </div>

                    </div>

                </div>

            </div>

            <!-- MENU -->

            <div class="mt-2">

                <a href="/Home/Index"
                   class="sidebar-link @(currentController == "Home" ? "active" : "")">

                    <i class="bi bi-speedometer2"></i>
                    Dashboard

                </a>

                <a href="/Product/Index"
                   class="sidebar-link @(currentController == "Product" && currentAction != "StokDurumu" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>
                    Ürünler

                </a>

                <a href="/Kategori/Index"
                   class="sidebar-link @(currentController == "Kategori" ? "active" : "")">

                    <i class="bi bi-tags"></i>
                    Kategoriler

                </a>

                <a href="/Product/StokDurumu"
                   class="sidebar-link @(currentAction == "StokDurumu" ? "active" : "")">

                    <i class="bi bi-exclamation-triangle"></i>
                    Kritik Stok

                </a>

                @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                {
                    @if (User.IsInRole("Owner"))
                    {
                        <a href="/Admin/Index"
                           class="sidebar-link @(currentController == "Admin" ? "active" : "")">

                            <i class="bi bi-shield-lock"></i>
                            Kullanıcı Yönetimi

                        </a>
                    }

                    <a href="/Log/Index"
                       class="sidebar-link @(currentController == "Log" ? "active" : "")">

                        <i class="bi bi-clock-history"></i>
                        Sistem Logları

                    </a>
                }

            </div>

            <!-- ALT -->

            <div class="mt-auto p-3">

                <a href="/Account/Profile"
                   class="btn btn-outline-light w-100 mb-2 logout-btn">

                    <i class="bi bi-person me-2"></i>
                    Profilim

                </a>
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger w-100 logout-btn">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Çıkış Yap

                    </button>

                </form>

            </div>

        </div>

        <!-- CONTENT -->

        <div id="page-content-wrapper">

            <div class="container-fluid p-3 p-md-4">

                <!-- NAVBAR -->

                <nav class="navbar navbar-expand-lg navbar-custom shadow-sm px-4 py-3 mb-4">

                    <button class="btn btn-dark mobile-toggle"
                            id="menu-toggle">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="ms-auto">

                        Hoş geldin,
                        <strong>
                            @Context.Session.GetString("Username")
                        </strong>

                    </div>

                </nav>

                <!-- ALERT -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success shadow-sm">

                        <i class="bi bi-check-circle me-2"></i>

                        @TempData["Success"]

                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger shadow-sm">

                        <i class="bi bi-x-circle me-2"></i>

                        @TempData["Error"]

                    </div>
                }

                <!-- BODY -->
                @RenderBody()

            </div>

        </div>

    </div>

    <script>

        var menuToggle = document.getElementById("menu-toggle");

        if (menuToggle) {
            menuToggle.addEventListener("click", function () {

                document
                    .getElementById("sidebar-wrapper")
                    .classList.toggle("active");

            });
        }

    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

