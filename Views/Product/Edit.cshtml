@model StokTakip.Models.Product

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Ürün Düzenle
            </h2>

            <p class="text-muted mb-0">
                Ürün bilgilerini güncelleyebilirsiniz.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Listeye Dön

        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <!-- SOL TARAF -->

                    <div class="col-lg-6">

                        <!-- ÜRÜN ADI -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Ürün Adı
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Ürün adı giriniz" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                        <!-- FİYAT -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Fiyat
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₺
                                </span>

                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger"></span>

                        </div>

                        <!-- STOK -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Stok Adedi
                            </label>

                            <input asp-for="Stock"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   placeholder="Stok miktarı giriniz" />

                            <span asp-validation-for="Stock"
                                  class="text-danger"></span>

                        </div>

                        <!-- KATEGORİ -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Kritik Stok
                            </label>

                            <input asp-for="CriticalStock"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="CriticalStock"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Kullanım Türü
                            </label>

                            <select asp-for="StockType"
                                    class="form-select">

                                <option value="Personal">
                                    Bireysel
                                </option>

                                <option value="Company">
                                    Şirket
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Kategori
                            </label>

                            <select asp-for="KategoriId"
                                    class="form-select"
                                    asp-items="ViewBag.KategoriListesi"
                                    id="kategoriSelect">

                                <option value="">
                                    -- Kategori Seçiniz --
                                </option>

                            </select>

                            <span asp-validation-for="KategoriId"
                                  class="text-danger"></span>

                        </div>

                        <!-- BUTONLAR -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success px-4">

                                <i class="bi bi-check-circle me-2"></i>
                                Değişiklikleri Kaydet

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                İptal

                            </a>

                        </div>

                    </div>

                    <!-- SAĞ TARAF -->

                    <div class="col-lg-6 mt-4 mt-lg-0">

                        <div class="bg-light rounded p-4 h-100">

                            <h5 class="fw-bold mb-3">
                                Ürün Bilgileri
                            </h5>

                            <div class="mb-3">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-box-seam text-primary me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Ürün Takibi
                                        </div>

                                        <small class="text-muted">
                                            Ürün bilgilerini güncel tutarak
                                            stok kontrolünü daha kolay yapabilirsiniz.
                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div class="mb-3">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-pencil-square text-warning me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Kolay Düzenleme
                                        </div>

                                        <small class="text-muted">
                                            Fiyat, stok ve kategori bilgilerini
                                            istediğiniz zaman değiştirebilirsiniz.
                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div>

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-shield-check text-success me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Güvenli Yönetim
                                        </div>

                                        <small class="text-muted">
                                            Tüm değişiklikler sistem kayıtlarına işlenir.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
