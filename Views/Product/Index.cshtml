@model IEnumerable<StokTakip.Models.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="container-fluid mt-3 mt-md-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-box-seam text-primary me-2"></i>

                Ürün Yönetimi

            </h2>

            <p class="text-muted mb-0">
                Ürünlerinizi yönetin ve stok hareketlerini takip edin.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success px-4 shadow-sm">

            <i class="bi bi-plus-circle me-2"></i>

            Yeni Ürün

        </a>

    </div>

    <!-- STATS -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Toplam Ürün
                            </div>

                            <h2 class="fw-bold mb-0">
                                @Model.Count()
                            </h2>

                        </div>

                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">

                            <i class="bi bi-box fs-3 text-primary"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Kritik Stok
                            </div>

                            <h2 class="fw-bold text-danger mb-0">
                                @Model.Count(x => (x.Stock ?? 0) <= x.CriticalStock)
                            </h2>

                        </div>

                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle">

                            <i class="bi bi-exclamation-triangle fs-3 text-danger"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Toplam Değer
                            </div>

                            <h4 class="fw-bold text-success mb-0">

                                ₺@Model.Sum(x =>
                                                                (x.Price ?? 0) *
                                                                (x.Stock ?? 0)).ToString("N0")

                            </h4>

                        </div>

                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">

                            <i class="bi bi-cash-stack fs-3 text-success"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- SEARCH -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-12 col-lg-5">

                        <input type="text"
                               name="searchString"
                               class="form-control"
                               placeholder="Ürün ara..." />

                    </div>

                    <div class="col-12 col-lg-5">

                        <select name="kategoriId"
                                class="form-select"
                                asp-items="ViewBag.Kategoriler">

                            <option value="">
                                Tüm Kategoriler
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-lg-2 d-grid">

                        <button class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Ara

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- PRODUCT TABLE -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-3">Ürün</th>

                            <th>Kategori</th>

                            <th>Fiyat</th>

                            <th>Stok</th>

                            <th>Hızlı İşlem</th>

                            <th class="text-center">İşlemler</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- PRODUCT -->

                                    <td class="ps-3">

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                rounded-circle
                                                                d-flex
                                                                align-items-center
                                                                justify-content-center
                                                                me-3"
                                                 style="width:45px;height:45px;">

                                                <i class="bi bi-box text-primary"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @item.Name
                                                </div>

                                                <small class="text-muted">
                                                    ID: #@item.Id
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="badge bg-light text-dark border">

                                            @(item.Kategori?.KategoriAd ?? "-")

                                        </span>

                                    </td>

                                    <!-- PRICE -->

                                    <td>

                                        <span class="fw-bold text-success">

                                            @(item.Price?.ToString("₺#,##0.00") ?? "-")

                                        </span>

                                    </td>

                                    <!-- STOCK -->

                                    <td>

                                        @if ((item.Stock ?? 0) <= item.CriticalStock)
                                        {
                                            <span class="badge bg-danger">
                                                @(item.Stock ?? 0) Adet
                                            </span>
                                        }
                                        else if ((item.Stock ?? 0) <= item.CriticalStock + 10)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @(item.Stock ?? 0) Adet
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @(item.Stock ?? 0) Adet
                                            </span>
                                        }

                                    </td>

                                    <!-- QUICK STOCK -->

                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- STOCK ADD -->

                                            <form asp-action="StockAction"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="quantity"
                                                       value="1" />

                                                <input type="hidden"
                                                       name="actionType"
                                                       value="add" />

                                                <button class="btn btn-sm btn-success">

                                                    <i class="bi bi-plus"></i>

                                                </button>

                                            </form>

                                            <!-- STOCK REMOVE -->

                                            <form asp-action="StockAction"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="quantity"
                                                       value="1" />

                                                <input type="hidden"
                                                       name="actionType"
                                                       value="remove" />

                                                <button class="btn btn-sm btn-danger">

                                                    <i class="bi bi-dash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-dark">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button class="btn btn-sm btn-danger">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox display-5 text-muted d-block mb-3"></i>

                                    <div class="text-muted">

                                        Henüz ürün bulunmuyor.

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>