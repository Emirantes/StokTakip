@model StokTakip.Models.Product

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    bool canManageCategories =
        User.IsInRole("Owner") || User.IsInRole("Admin");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Yeni Ürün Ekle
            </h2>

            <p class="text-muted mb-0">
                Evinizdeki veya işletmenizdeki ürünleri kolayca takip edin.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Listeye Dön

        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-lg-6">

                        <!-- ÜRÜN ADI -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Ürün Adı
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Örn: Laptop, Masa Lambası, Kahve Makinesi" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                        <!-- FİYAT -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Fiyat
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₺
                                </span>

                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger"></span>

                        </div>

                        <!-- STOK -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Stok Miktarı
                            </label>

                            <input asp-for="Stock"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   placeholder="Adet giriniz" />

                            <span asp-validation-for="Stock"
                                  class="text-danger"></span>

                        </div>

                        <!-- KATEGORİ -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Kritik Stok
                            </label>

                            <input asp-for="CriticalStock"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="CriticalStock"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Kullanım Türü
                            </label>

                            <select asp-for="StockType"
                                    class="form-select">

                                <option value="Personal">
                                    Bireysel
                                </option>

                                <option value="Company">
                                    Şirket
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Kategori
                            </label>

                            <div class="input-group">

                                <select asp-for="KategoriId"
                                        class="form-select"
                                        id="kategoriSelect"
                                        asp-items="ViewBag.KategoriListesi">

                                    <option value="">
                                        -- Kategori Seçiniz --
                                    </option>

                                </select>

                                @if (canManageCategories)
                                {
                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#hizliKategoriModal">

                                        <i class="bi bi-plus-lg"></i>

                                    </button>
                                }

                            </div>

                            <span asp-validation-for="KategoriId"
                                  class="text-danger"></span>

                            @if (canManageCategories)
                            {
                                <div class="form-text">
                                    İsterseniz hızlıca yeni kategori oluşturabilirsiniz.
                                </div>
                            }

                        </div>

                        <!-- BUTONLAR -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success px-4">

                                <i class="bi bi-check-circle me-2"></i>
                                Ürünü Kaydet

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                Vazgeç

                            </a>

                        </div>

                    </div>

                    <!-- SAĞ BİLGİ PANELİ -->

                    <div class="col-lg-6 mt-4 mt-lg-0">

                        <div class="bg-light rounded p-4 h-100">

                            <h5 class="fw-bold mb-3">
                                Bilgilendirme
                            </h5>

                            <div class="mb-3">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-box-seam text-primary me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Ürün Takibi
                                        </div>

                                        <small class="text-muted">
                                            Elektronik, mutfak eşyası,
                                            ofis ürünleri veya kişisel eşyalarınızı takip edebilirsiniz.
                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div class="mb-3">

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-graph-up text-success me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Stok Kontrolü
                                        </div>

                                        <small class="text-muted">
                                            Azalan ürünleri kolayca görüntüleyebilirsiniz.
                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div>

                                <div class="d-flex align-items-start">

                                    <i class="bi bi-tags text-warning me-3 fs-5"></i>

                                    <div>

                                        <div class="fw-semibold">
                                            Kategori Düzeni
                                        </div>

                                        <small class="text-muted">
                                            Ürünlerinizi kategorilere ayırarak daha düzenli yönetebilirsiniz.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- HIZLI KATEGORİ MODAL -->

<div class="modal fade"
     id="hizliKategoriModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title">
                    Yeni Kategori Ekle
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="hizliKategoriMesaj"
                     class="alert d-none"
                     role="alert">
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Kategori Adı
                    </label>

                    <input type="text"
                           id="yeniKategoriAd"
                           class="form-control"
                           placeholder="Örn: Elektronik" />

                </div>

                <div class="mb-0">

                    <label class="form-label">
                        Açıklama
                    </label>

                    <textarea id="yeniKategoriAciklama"
                              class="form-control"
                              rows="3"
                              placeholder="Kategori açıklaması"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    İptal

                </button>

                <button type="button"
                        id="btnKategoriKaydet"
                        class="btn btn-primary">

                    Kaydet

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>

        $('#btnKategoriKaydet').click(function () {

            var kategoriAd =
                $('#yeniKategoriAd').val();

            var aciklama =
                $('#yeniKategoriAciklama').val();

            if (kategoriAd.trim() === '') {

                showCategoryMessage('Kategori adı boş olamaz.', false);
                return;
            }

            var token =
            $('input[name="__RequestVerificationToken"]').val();

                $.ajax({

                url: '/Kategori/HizliEkle',

                type: 'POST',

                headers: {
                'RequestVerificationToken': token
                },

                data: {
                kategoriAd: kategoriAd,
                aciklama: aciklama
                },

                success: function (response) {

                    if (response.success) {

                        $('#kategoriSelect').append(

                            $('<option>', {

                                value: response.id,
                                text: response.ad,
                                selected: true

                            })

                        );

                        $('#hizliKategoriModal').modal('hide');

                        $('#yeniKategoriAd').val('');
                        $('#yeniKategoriAciklama').val('');

                        showCategoryMessage(response.message || 'Kategori başarıyla oluşturuldu.', true);
                    }
                    else {

                        showCategoryMessage(response.message || 'Kategori oluşturulamadı.', false);
                    }
                },

                error: function () {

                    showCategoryMessage('Bir hata oluştu. Lütfen tekrar deneyin.', false);
                }

            });

        });

        function showCategoryMessage(message, isSuccess) {

            if (window.Swal) {
                Swal.fire({
                    icon: isSuccess ? 'success' : 'error',
                    title: isSuccess ? 'Başarılı' : 'İşlem tamamlanamadı',
                    text: message,
                    confirmButtonText: 'Tamam'
                });

                return;
            }

            var alertClass = isSuccess ? 'alert-success' : 'alert-danger';
            var messageBox = $('#hizliKategoriMesaj');

            messageBox
                .removeClass('d-none alert-success alert-danger')
                .addClass(alertClass)
                .text(message);
        }

    </script>
}
