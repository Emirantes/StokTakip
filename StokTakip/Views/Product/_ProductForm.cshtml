@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @model Product

    <div class="mb-3">
        <label class="form-label">Ürün Adı</label>
        <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Gaming Laptop">
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Fiyat</label>
            <div class="input-group">
                <span class="input-group-text">₺</span>
                <input type="number" class="form-control" asp-for="Price">
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Stok Adedi</label>
            <input type="number" class="form-control" asp-for="Stock">
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Kategori Seçin</label>
        <select class="form-select" asp-for="KategoriId">
            <option value="1">Elektronik</option>
            <option value="2">Aksesuar</option>
        </select>
    </div>
}
