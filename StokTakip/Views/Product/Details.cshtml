@model StokTakip.Models.Product

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white py-3">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Ürün Detayları</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Ürün Adı:</strong> @Model.Name</p>
                    @(Model.Price.HasValue
                    ? Model.Price.Value.ToString("C2")
                    : "-")
                    <p>
                        <strong>Stok Miktarı:</strong>
                        <span class="badge @(Model.Stock < 10 ? "bg-danger" : "bg-success")">
                            @Model.Stock Adet
                        </span>
                    </p>
                </div>
                <div class="col-md-6 border-start">
                    <p><strong>Eklenme Tarihi:</strong> @DateTime.Now.ToShortDateString()</p>
                    <p><strong>Durum:</strong> @(Model.Stock > 0 ? "Satışta" : "Stokta Yok")</p>
                </div>
            </div>
            <hr />
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </div>
    </div>
</div>